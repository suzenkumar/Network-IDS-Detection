# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Trained model artefacts (regenerated by `python train_model.py`)
models/*.joblib
models/metrics.json

# Real datasets are large — drop them into data/ locally
data/*.csv
data/*.gz
data/*.zip

# Live-mode alert logs (JSONL, written by the real-time monitor)
logs/

# Flask
instance/
*.log

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
